{
  "name": "wavey",
  "private": true,
  "version": "0.1.0",
  "description": "Wavey — convert YouTube to MP3/MP4 and save public Instagram reels. Vite + Vercel serverless.",
  "license": "MIT",
  "author": "Wavey contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuthanm/wavey.git"
  },
  "bugs": {
    "url": "https://github.com/nuthanm/wavey/issues"
  },
  "homepage": "https://github.com/nuthanm/wavey#readme",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "dev": "vite",
    "dev:api": "tsx scripts/local-api.ts",
    "dev:web": "vite",
    "dev:split": "concurrently -k -n api,web -c lime,cyan \"npm run dev:api\" \"vite --port 5173\"",
    "dev:full": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "check:yt-cookie": "node scripts/verify-yt-cookie.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "framer-motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
