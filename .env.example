# Required in production — used to sign short-lived stream tokens
WAVEY_TOKEN_SECRET=change-me-to-a-long-random-string

# Required if you want age-restricted / login-gated YouTube videos to work for visitors.
# Without this, YouTube blocks those streams — Wavey cannot invent a login.
#
# How to get it (use YOUR age-verified Google account):
# 1. Open a private/incognito window
# 2. Sign in to https://www.youtube.com
# 3. DevTools → Network → click any request to youtube.com
# 4. Copy the full Request Headers → Cookie value
# 5. Paste it below on one line (must include SID + SAPISID, or __Secure-3PSID + __Secure-3PAPISID)
# 6. Close the private window
# 7. Restart npm run dev / redeploy Vercel after changing this
#
# YT_COOKIE=VISITOR_INFO1_LIVE=...; SID=...; HSID=...; SSID=...; APISID=...; SAPISID=...; __Secure-3PSID=...; __Secure-3PAPISID=...

# Optional — Instagram stories (public reels work without this)
# IG_SESSIONID=your_sessionid_value
# IG_DS_USER_ID=
# IG_CSRFTOKEN=
